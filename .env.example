# ---------------------------------------------------------------------------
# Point-in-Time Analytics Lab — environment template
# ---------------------------------------------------------------------------
# Copy to `.env` and adjust. `.env` is git-ignored.
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
# ---------------------------------------------------------------------------

# --- Warehouse connection (PostgreSQL) ------------------------------------
# Defaults match both the native installer and docker-compose.yml, so the
# project runs unchanged on either.
PIT_DB_HOST=localhost
PIT_DB_PORT=5432
PIT_DB_NAME=pit_lab
PIT_DB_USER=postgres
PIT_DB_PASSWORD=pitlab_dev_2026
PIT_DB_SCHEMA=public

# --- Paths ----------------------------------------------------------------
# Relative to the repository root.
PIT_RAW_PRICES_DIR=data/raw/prices
PIT_RAW_REFERENCE_DIR=data/raw/reference
PIT_PROCESSED_DIR=data/processed

# --- Analysis window ------------------------------------------------------
# The price corpus spans 2015-12-21 to 2025-12-19.
#
# The start date is NOT arbitrary. Two GICS sectors were created inside the
# corpus period: Real Estate (S&P 500 implementation after close 2016-09-16)
# and Communication Services (2018-09-24). Constituent-level history is seeded
# for the Communication Services event but not for the Real Estate one, so the
# window opens in Q4 2016 - after the Real Estate separation completed - which
# leaves exactly one sector-creation event inside the window, and a fully
# sourced one. See docs/sector_sources.md section 5.
PIT_ANALYSIS_START=2016-10-03
PIT_ANALYSIS_END=2025-12-19

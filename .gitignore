# ---------------------------------------------------------------------------
# Point-in-Time Analytics Lab — ignore rules
# ---------------------------------------------------------------------------

# --- Raw data -------------------------------------------------------------
# The OHLCV price corpus is ~106 MB across 501 per-ticker CSVs. It is NOT
# committed - too large for a portfolio repo, and the Kaggle source has no
# single stable re-download URL (see README "Reproducing this project" for
# how to source it locally).
#
# The small reference CSVs under data/raw/reference/ (sp500_current_snapshot
# .csv, sp500_ticker_start_end.csv - ~80 KB combined) ARE committed. They are
# what `python -m pit_lab.ingest --skip-prices` needs, including in CI - a
# repo without them cannot reproduce even the reference-only path from a
# fresh clone, which is exactly the bug that first version of this rule had.
data/raw/prices/
data/interim/

# Committed on purpose — the dashboard's serving layer.
!data/processed/
!data/processed/**

# --- Local warehouse ------------------------------------------------------
*.duckdb
*.duckdb.wal
!data/processed/*.duckdb

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib60/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual environments -------------------------------------------------
.venv/
venv/
ENV/
env/

# --- Testing / linting ----------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- dbt ------------------------------------------------------------------
dbt_pit/target/
dbt_pit/dbt_packages/
dbt_pit/logs/
logs/
.user.yml

# --- Secrets --------------------------------------------------------------
.env
.env.*
!.env.example
profiles.yml
!config/profiles.example.yml

# --- Jupyter --------------------------------------------------------------
.ipynb_checkpoints/

# --- Streamlit ------------------------------------------------------------
.streamlit/secrets.toml

# --- OS / editor ----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# --- Local tooling ----------------------------------------------------------
# Claude Code's local session settings — machine-specific, not project content.
.claude/settings.local.json
